# Maintainer: nathawat <nathawat at noreply dot codeberg dot org>

pkgname=hyprmt-brightstay
pkgver=3.0.1
pkgrel=1
_tag=v${pkgver}
pkgdesc="Hyprland monitor toggle utility inspired by the Windows + P display picker"
arch=("x86_64")
url="https://codeberg.org/nathawat/hyprmt"
license=("GPL-3.0-or-later")
depends=("glibc" "hyprland>=0.55.0")
makedepends=("cargo")
optdepends=("fuzzel: overlay picker support")
provides=("hyprmt")
conflicts=("hyprmt")
replaces=("hyprmt")
install=hyprmt.install
source=("hyprmt-${pkgver}.tar.gz::https://codeberg.org/nathawat/hyprmt/archive/${_tag}.tar.gz")
b2sums=('81323ac6b075d5db99a6c972357077fa7b7ae627ba7e39458abc223365f607b957b1fb3ff3597ecc3565a5d4172bfc827cf80e843d0e002a26bef934e58099c1')

prepare() {
	cd "${srcdir}/hyprmt"
	cargo fetch --locked
}

build() {
	cd "${srcdir}/hyprmt"
	cargo build --frozen --release --features brightstay
}

check() {
	cd "${srcdir}/hyprmt"
	cargo test --frozen --features brightstay
}

package() {
	cd "${srcdir}/hyprmt"
	install -Dm755 "target/release/hyprmt" "${pkgdir}/usr/bin/hyprmt"
	install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
	install -Dm644 "arch/assets/systemd/brightstay.service" "${pkgdir}/etc/systemd/system/brightstay.service"
	install -Dm644 "arch/assets/sysusers.d/hyprmt.sysusers" "${pkgdir}/usr/lib/sysusers.d/hyprmt.sysusers"
	install -Dm644 "arch/assets/tmpfiles.d/fix-l22i-40.conf" "${pkgdir}/usr/lib/tmpfiles.d/fix-l22i-40.conf"
	install -Dm644 "arch/assets/udev/rules.d/45-hyprmt.rules" "${pkgdir}/usr/lib/udev/rules.d/hyprmt.rules"
	install -Dm644 "arch/assets/modules-load.d/hyprmt.conf" "${pkgdir}/usr/lib/modules-load.d/hyprmt.conf"
}
