# Maintainer: nathawat <nathawat at noreply dot codeberg dot org>

pkgname=hyprmt-brightstay
pkgver=3.0.0
pkgrel=1
pkgdesc="Hyprland monitor toggle utility inspired by the Windows + P display picker"
arch=("x86_64")
url="https://codeberg.org/nathawat/hyprmt"
license=("GPL-3.0-or-later")
depends=("glibc" "hyprland>=0.55.0")
makedepends=("cargo" "git")
optdepends=("fuzzel: overlay picker support")
provides=("hyprmt")
conflicts=("hyprmt")
replaces=("hyprmt")
source=(
    "git+${url}.git#tag=v${pkgver}"
    "hyprmt.install"
    "hyprmt.sysusers"
    "45-hyprmt.rules"
    "hyprmt.conf"
    "brightstay.service"
)
b2sums=(
    '62508250a872b4f4d29d17460c1540fbc8f7dc82d55cce1da0ac807d41270db80488ef0684b4b8cee772c32667b12828b4ed3016a3fde426cb6216590b474c15'
    'e023fb49449f158b2a607f80517f446d942e140bc45e4b4a2f303aac382dedac7f8aadd3260f96a0fdb821bc5274c8e8056eae17a43c2b6c4605511681859e2e'
    '8577cab4f6c94058f8926e82765d25c9c9b43cc13ae7d462965770684293dc0692c305226107d570517185f119df8df4c6f9de8bec991e5ee59edc8bcd957a09'
    'e0d5cd0bab39ca44e978b7315de99ed05c687cce9acfb7e5f22a11e1b9d4f8743b41761ffa6cc85812bd265b3dfc90e231e56bd99bd5c3f6cd982c6aef02ca23'
    'f6f411b54c813432f854c258a3de9c4588119ef7ef6bd4785d5af52696a83a3182c20de8f8de0af6da04d8200727d187d2e3a44aac2a8b59b7e92c98265a3ef6'
    '3bf129fc7eab82a04e43d4f110c8ff524da28b1dc2585b1d8012e47748b1dec4ae7f296667a47dc1b19a81c2e36c3f981b39d93a45d50bce6fd98b52527c8d62'
)

prepare() {
    cd "${srcdir}/hyprmt"
    cargo fetch --locked
}

build() {
  cd "${srcdir}/hyprmt"
  cargo build --frozen --release --features brightstay
}

check() {
  cd "${srcdir}/hyprmt"
  cargo test --frozen
}

package() {
  cd "${srcdir}/hyprmt"
  install -Dm755 "target/release/hyprmt" "${pkgdir}/usr/bin/hyprmt"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 "${startdir}/brightstay.service" "${pkgdir}/etc/systemd/system/brightstay.service"
  install -Dm644 "${startdir}/hyprmt.sysusers" "${pkgdir}/usr/lib/sysusers.d/hyprmt.sysusers"
  install -Dm644 "${startdir}/45-hyprmt.rules" "${pkgdir}/usr/lib/udev/rules.d/hyprmt.rules"
  install -Dm644 "${startdir}/hyprmt.conf" "${pkgdir}/usr/lib/modules-load.d/hyprmt.conf"
  install -Dm644 "${startdir}/hyprmt.install" "${pkgdir}/usr/share/libalpm/scripts/hyprmt.install"
}
